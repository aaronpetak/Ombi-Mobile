<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (targetSdk 31+): cloud backup and device-to-device
  transfer. The DataStore preferences file holds the plaintext Ombi server URL,
  which should not leave the device via a cloud backup, so it is excluded from
  both transports. The encrypted auth token lives in a Keystore-backed store that
  is device-tied and useless if restored elsewhere, so it needs no rule here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
